{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "findings"
  ],
  "properties": {
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "file",
          "side",
          "line",
          "description",
          "evidence",
          "recommendation",
          "confidence",
          "blocking"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "Critical",
              "High",
              "Medium",
              "Low"
            ]
          },
          "file": {
            "type": "string"
          },
          "side": {
            "type": "string",
            "enum": [
              "base",
              "candidate"
            ]
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "description": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "blocking": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
