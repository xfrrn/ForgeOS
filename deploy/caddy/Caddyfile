{
	admin off
	auto_https off
}

https://*.{$FORGEOS_GATEWAY_DOMAIN}:{$FORGEOS_GATEWAY_PORT:443} {
	bind {$FORGEOS_GATEWAY_BIND:127.0.0.1}
	tls {$FORGEOS_TLS_CERT} {$FORGEOS_TLS_KEY} {
		client_auth {
			mode require_and_verify
			trust_pool file {$FORGEOS_CLIENT_CA}
		}
	}

	@workbench {
		host forgeos.{$FORGEOS_GATEWAY_DOMAIN}
		path / /ui /ui/ /ui/assets/* /auth/session /auth/login /auth/logout /tasks /tasks/* /projects /projects/* /executions/* /workers /workers/control-plane /workers/model-budgets /global-rules
	}
	handle @workbench {
		reverse_proxy {$FORGEOS_CONTROL_UPSTREAM:127.0.0.1:8080}
	}

	@worker_pool_settings {
		host forgeos.{$FORGEOS_GATEWAY_DOMAIN}
		method PUT
		path /workers/fixed-pool /workers/process-pool
	}
	handle @worker_pool_settings {
		reverse_proxy {$FORGEOS_CONTROL_UPSTREAM:127.0.0.1:8080}
	}

	@native_approval {
		host forgeos.{$FORGEOS_GATEWAY_DOMAIN}
		method POST
		path_regexp approval ^/native-approvals/[1-9][0-9]*$
	}
	handle @native_approval {
		reverse_proxy {$FORGEOS_CONTROL_UPSTREAM:127.0.0.1:8080}
	}

	@role_archive {
		host forgeos.{$FORGEOS_GATEWAY_DOMAIN}
		method GET HEAD
		path_regexp archive ^/role-processes/[1-9][0-9]*/instances/[1-9][0-9]*/archive$
	}
	handle @role_archive {
		reverse_proxy {$FORGEOS_CONTROL_UPSTREAM:127.0.0.1:8080}
	}

	@preview vars_regexp preview {http.request.host} ^(p-[a-f0-9]{48})[.]
	handle @preview {
		reverse_proxy {$FORGEOS_PREVIEW_UPSTREAM:127.0.0.1:8091} {
			header_up Host {re.preview.1}.localhost:{$FORGEOS_PREVIEW_PORT:8091}
			header_up -Authorization
			header_up -Cookie
		}
	}

	handle {
		respond 404
	}
}
