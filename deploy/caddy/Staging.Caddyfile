{
	admin off
	auto_https off
}

https://:{$FORGEOS_STAGING_PORT:8443} {
	bind {$FORGEOS_STAGING_BIND:127.0.0.1}
	tls {$FORGEOS_STAGING_TLS_CERT} {$FORGEOS_STAGING_TLS_KEY}

	@callback {
		host {$FORGEOS_STAGING_HOST}
		path /callback
		method GET POST
	}
	handle @callback {
		rewrite * {$FORGEOS_STAGING_APP_PATH:/callback}
		reverse_proxy {$FORGEOS_STAGING_UPSTREAM}
	}

	handle {
		respond 404
	}
}
