{
  "manifest_version": 3,
  "name": "ForgeOS 预览反馈",
  "version": "1.1.0",
  "description": "在固定候选上批注、截图或录制当前标签页，到已连接的 ForgeOS 工作台提交反馈。",
  "permissions": ["activeTab", "scripting", "tabCapture"],
  "action": { "default_popup": "popup.html", "default_title": "ForgeOS 预览反馈" },
  "commands": { "_execute_action": { "suggested_key": { "default": "Alt+Shift+F" } } }
}
