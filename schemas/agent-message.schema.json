{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forgeos:agent-message:1.0",
  "title": "ForgeOS Agent message",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "message_id", "correlation_id", "project_id", "goal_id", "work_item_id", "execution_id", "from", "to", "message_type", "payload", "timestamp", "idempotency_key", "trust_level"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "message_id": { "$ref": "#/$defs/id" },
    "correlation_id": { "$ref": "#/$defs/id" },
    "project_id": { "$ref": "#/$defs/id" },
    "goal_id": { "$ref": "#/$defs/optionalId" },
    "work_item_id": { "$ref": "#/$defs/optionalId" },
    "execution_id": { "$ref": "#/$defs/optionalId" },
    "from": { "$ref": "#/$defs/actor" },
    "to": { "$ref": "#/$defs/actor" },
    "message_type": { "enum": ["EVENT", "COMMAND", "REQUEST", "RESPONSE", "RESULT"] },
    "payload": { "type": "object" },
    "timestamp": { "type": "string", "format": "date-time" },
    "idempotency_key": { "$ref": "#/$defs/id" },
    "trust_level": { "$ref": "#/$defs/id" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "optionalId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "actor": {
      "type": "object", "additionalProperties": false, "required": ["type", "id"],
      "properties": { "type": { "$ref": "#/$defs/id" }, "id": { "$ref": "#/$defs/id" } }
    }
  }
}
