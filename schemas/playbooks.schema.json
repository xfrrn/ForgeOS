{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ForgeOS global acceptance playbooks",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "playbooks"],
  "properties": {
    "version": {"const": 1},
    "playbooks": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_-]{0,63}$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "objective", "preconditions", "steps", "expected_result", "evidence"],
        "properties": {
          "title": {"$ref": "#/$defs/text"},
          "objective": {"$ref": "#/$defs/text"},
          "preconditions": {"$ref": "#/$defs/text"},
          "steps": {"$ref": "#/$defs/list"},
          "expected_result": {"$ref": "#/$defs/text"},
          "evidence": {"$ref": "#/$defs/list"}
        }
      }
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "\\S"},
    "list": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}
  }
}
