{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forgeos:project:v1",
  "type": "object",
  "required": ["version"],
  "properties": {
    "version": { "const": 1 },
    "local_environments": {
      "type": "object",
      "propertyNames": { "enum": ["local-mock", "local-integrated"] },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start_script", "port", "health_path", "timeout_seconds"],
        "properties": {
          "start_script": { "type": "string", "minLength": 1, "maxLength": 512 },
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "health_path": { "type": "string", "pattern": "^/[A-Za-z0-9._~/\\-]*$", "maxLength": 512 },
          "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 300 }
        }
      }
    },
    "secret_requirements": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["environment", "name", "risk"],
        "properties": {
          "environment": { "enum": ["local-mock", "local-integrated", "ci-test", "staging", "production"] },
          "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$" },
          "risk": { "enum": ["S0", "S1", "S2", "S3"] }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_harness": { "enum": ["codex", "claude"] },
        "default_write_concurrency": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
