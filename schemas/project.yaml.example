version: 1

project:
  id: example-project
  name: Example Project
  repository:
    provider: github
    owner: example-org
    name: example-repo
    default_branch: main
  local:
    path: /projects/example-project

execution:
  default_harness: codex
  default_write_concurrency: 1

secret_requirements:
  - environment: local-mock
    name: queue-test-key
    risk: S1
  - environment: staging
    name: queue-service-key
    risk: S2

local_environments:
  local-mock:
    start_script: scripts/start-mock.sh
    port: 8080
    health_path: /ready
    timeout_seconds: 30
  local-integrated:
    start_script: scripts/start-integrated.sh
    port: 8080
    health_path: /ready
    timeout_seconds: 60

delivery:
  pull_request:
    enabled: true
    target_branch: main
    merge_strategy: squash
    auto_merge_after_acceptance: true
  production_deployment:
    enabled: false
    responsibility: human
