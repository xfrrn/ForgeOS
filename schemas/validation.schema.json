{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ForgeOS validation configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "checks",
    "profiles"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "checks": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/check"
      }
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 4,
      "propertyNames": {
        "enum": [
          "fast",
          "standard",
          "integration",
          "critical"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "checks"
        ],
        "properties": {
          "checks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^:\\\\\u0000-\u001f]+$"
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "command",
        "timeout_seconds"
      ],
      "properties": {
        "type": {
          "enum": [
            "static",
            "unit",
            "build",
            "integration",
            "security",
            "regression"
          ]
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "prefixItems": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^[^\u0000]+$"
            }
          ],
          "items": {
            "type": "string",
            "maxLength": 2048,
            "pattern": "^[^\u0000]*$"
          }
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "working_directory": {
          "$ref": "#/$defs/path"
        },
        "environment": {
          "const": "ci"
        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "reports": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "artifacts": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        }
      }
    }
  }
}
